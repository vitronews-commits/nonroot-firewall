<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <application android:label="Firewall Test Probe" android:testOnly="true" android:usesCleartextTraffic="false">
        <receiver android:name=".ProbeAdmin" android:permission="android.permission.BIND_DEVICE_ADMIN" android:exported="true">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/probe_admin"/>
            <intent-filter><action android:name="android.app.action.DEVICE_ADMIN_ENABLED"/></intent-filter>
        </receiver>
    </application>
    <instrumentation android:name=".ProbeInstrumentation" android:targetPackage="com.nonroot.firewall.probe"/>
</manifest>
